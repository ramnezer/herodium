#!/opt/herodium/venv/bin/python3
import curses
import os
import re
import time
from pathlib import Path

import psutil


# Path configurations
LOG_FILE = "/opt/herodium/logs/herodium.log"
SERVICE_CGROUP_PROCS = Path(
    "/sys/fs/cgroup/system.slice/herodium.service/cgroup.procs"
)
ENGINE_PATH = "/opt/herodium/core/engine.py"
_TAIL_BLOCK_SIZE = 8192


def require_root():
    """Require root because Herodium logs are root-only by design."""
    if os.geteuid() != 0:
        print("ERROR: herodium-top must be run with sudo.")
        print("Run: sudo herodium-top")
        raise SystemExit(1)


def _cgroup_has_live_processes():
    """Return True when the Herodium systemd cgroup contains a live process."""
    try:
        raw_pids = SERVICE_CGROUP_PROCS.read_text(encoding="ascii")
    except OSError:
        return False

    for raw_pid in raw_pids.splitlines():
        pid = raw_pid.strip()
        if pid.isdigit() and Path("/proc", pid).exists():
            return True

    return False


def _engine_process_is_running():
    """Fallback service check for systems without the expected cgroup path."""
    try:
        processes = psutil.process_iter(["cmdline"])
        for proc in processes:
            cmdline = proc.info.get("cmdline") or ()
            if ENGINE_PATH in cmdline:
                return True
    except psutil.Error:
        return False

    return False


def get_system_status():
    """Check whether the Herodium engine has a live service process."""
    if _cgroup_has_live_processes() or _engine_process_is_running():
        return "active"
    return "inactive"


def get_cpu_temp():
    """Fetch maximum CPU core temperature."""
    try:
        temps = psutil.sensors_temperatures()
    except (AttributeError, psutil.Error):
        return "N/A"

    if not temps:
        return "N/A"

    max_temp = 0.0
    for entries in temps.values():
        for entry in entries:
            if entry.current is not None and entry.current > max_temp:
                max_temp = entry.current

    return f"{int(max_temp)}°C" if max_temp > 0 else "N/A"


def get_clamav_resources():
    """Monitor ClamAV (clamd) CPU and memory usage."""
    try:
        processes = psutil.process_iter(["name", "cpu_percent", "memory_info"])
        for proc in processes:
            name = proc.info.get("name") or ""
            memory_info = proc.info.get("memory_info")
            if "clamd" not in name or memory_info is None:
                continue

            cpu_percent = proc.info.get("cpu_percent") or 0.0
            memory_mb = memory_info.rss / (1024 * 1024)
            return cpu_percent, memory_mb
    except psutil.Error:
        return 0.0, 0.0

    return 0.0, 0.0


def _read_last_lines(path, limit):
    """Read at most the final limit UTF-8 lines without loading the whole file."""
    if limit <= 0:
        return []

    chunks = []
    newline_count = 0

    with open(path, "rb") as handle:
        handle.seek(0, os.SEEK_END)
        position = handle.tell()

        while position > 0 and newline_count <= limit:
            read_size = min(_TAIL_BLOCK_SIZE, position)
            position -= read_size
            handle.seek(position)
            chunk = handle.read(read_size)
            chunks.append(chunk)
            newline_count += chunk.count(b"\n")

    data = b"".join(reversed(chunks))
    return data.decode("utf-8", errors="replace").splitlines()[-limit:]


def get_recent_detections(limit=8):
    """Parse the log for the latest security events."""
    if limit <= 0 or not os.path.exists(LOG_FILE):
        return []

    try:
        tail = "\n".join(_read_last_lines(LOG_FILE, 1000))
    except OSError:
        return []

    pattern = (
        r"(VIRUS DETECTED|MEMORY HUNTER TRIGGERED|"
        r"KILLING INFECTED PROCESS).*?: (.*)"
    )
    matches = re.findall(pattern, tail)
    detections = []

    for event_type, event_value in matches[-limit:]:
        clean_path = event_value.split("(", 1)[0].strip()
        clean_name = os.path.basename(clean_path)
        detections.append(f"{event_type}: {clean_name}")

    return detections


def get_last_memory_scan_count():
    """Extract the last Memory Scan process count from the log."""
    if not os.path.exists(LOG_FILE):
        return "0"

    try:
        tail = "\n".join(_read_last_lines(LOG_FILE, 200))
    except OSError:
        return "0"

    matches = re.findall(r"Memory Scan: checked (\d+) processes", tail)
    return matches[-1] if matches else "0"


def clear_logs():
    """Truncate the log file to reset stats."""
    try:
        with open(LOG_FILE, "w", encoding="utf-8") as handle:
            handle.write(
                f"{time.strftime('%Y-%m-%d %H:%M:%S')} - [HERODIUM] - INFO - "
                "Logs cleared by user. Stats reset.\n"
            )
    except OSError:
        return False

    return True


def _safe_addstr(stdscr, row, column, text, attributes=0):
    """Write to curses and report whether the terminal accepted the text."""
    try:
        stdscr.addstr(row, column, text, attributes)
    except curses.error:
        return False
    return True


def draw_dashboard(stdscr):
    """Main curses dashboard loop."""
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(2000)

    show_cleared_msg = 0

    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()

        # Header
        header = "HERODIUM SECURITY REAL-TIME DASHBOARD "
        stdscr.attron(curses.A_BOLD | curses.color_pair(1))
        stdscr.addstr(0, max(0, (width - len(header)) // 2), header)
        stdscr.attroff(curses.A_BOLD | curses.color_pair(1))
        stdscr.addstr(1, 0, "—" * width)

        # Status line
        status = get_system_status()
        stdscr.addstr(3, 2, "ENGINE: ")
        color = curses.color_pair(2) if status == "active" else curses.color_pair(3)
        stdscr.addstr(status.upper(), color | curses.A_BOLD)

        temp = get_cpu_temp()
        stdscr.addstr(3, 25, f"TEMP: {temp}")

        cpu_usage = psutil.cpu_percent()
        stdscr.addstr(3, 40, f"SYSTEM LOAD: {cpu_usage}%")

        # Resources and stats
        clam_cpu, clam_mem = get_clamav_resources()
        last_scan_cnt = get_last_memory_scan_count()

        stdscr.addstr(5, 2, "ANTIVIRUS ENGINE (ClamD):", curses.A_UNDERLINE)
        stdscr.addstr(6, 4, f"• CPU: {clam_cpu}%")
        stdscr.addstr(7, 4, f"• RAM: {clam_mem:.1f} MB")

        stdscr.addstr(5, 40, "MEMORY HUNTER:", curses.A_UNDERLINE)
        stdscr.addstr(6, 42, f"• Last Scan: {last_scan_cnt} processes")

        # Threat history
        stdscr.addstr(10, 2, "LATEST SECURITY EVENTS:", curses.A_UNDERLINE)

        if show_cleared_msg > 0:
            stdscr.addstr(
                11,
                4,
                "LOGS CLEARED! Statistics reset.",
                curses.color_pair(2),
            )
            show_cleared_msg -= 1
        else:
            detections = get_recent_detections()
            if not detections:
                stdscr.addstr(11, 4, "No recent threats. Monitoring system...")
            else:
                for index, detection in enumerate(reversed(detections)):
                    if 11 + index < height - 2:
                        stdscr.addstr(
                            11 + index,
                            4,
                            f"[{index + 1}] {detection}",
                            curses.color_pair(3),
                        )

        # Footer
        footer = " PRESS 'C' TO CLEAR STATS | 'Q' TO EXIT | REFRESH: 2S "
        _safe_addstr(
            stdscr,
            height - 1,
            max(0, (width - len(footer)) // 2),
            footer,
            curses.A_REVERSE,
        )

        stdscr.refresh()

        # Input handling
        key = stdscr.getch()
        if key in [ord("q"), ord("Q")]:
            break
        if key in [ord("c"), ord("C")] and clear_logs():
            show_cleared_msg = 2


def init_curses(stdscr):
    """Initialize curses colors and start dashboard."""
    curses.start_color()
    curses.init_pair(1, curses.COLOR_CYAN, curses.COLOR_BLACK)
    curses.init_pair(2, curses.COLOR_GREEN, curses.COLOR_BLACK)
    curses.init_pair(3, curses.COLOR_RED, curses.COLOR_BLACK)
    draw_dashboard(stdscr)


def main():
    require_root()
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(init_curses)


if __name__ == "__main__":
    main()
